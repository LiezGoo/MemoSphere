NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=alaala
MYSQL_USER=alaala_app
MYSQL_PASSWORD=change-me-locally
DATABASE_URL=mysql://alaala_app:change-me-locally@localhost:3307/alaala

AUTH_SECRET=replace-with-a-local-development-secret
AUTH_COOKIE_SAMESITE=lax
AI_PROVIDER_API_KEY=replace-locally-never-commit
AI_MODEL_ID=replace-with-approved-model
AI_TRANSCRIPTION_API_KEY=replace-locally-never-commit
AI_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MAX_FILE_SIZE_MB=25
TRANSCRIPTION_MAX_DURATION_SECONDS=600
GROQ_API_KEY=replace-locally-never-commit
GROQ_STT_MODEL=whisper-large-v3
FACE_TEMPLATE_KEY=base64-encoded-32-byte-key
FACE_MATCH_THRESHOLD=0.52
