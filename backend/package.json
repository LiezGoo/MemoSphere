{
  "name": "@alaala/backend",
  "private": true,
  "scripts": {
    "dev": "npm run check:env && tsx watch src/server.ts",
    "check:env": "tsx scripts/check-env.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "db:verify": "tsx scripts/verify-database.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "simulate:release": "tsx scripts/simulate-release.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
