generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum LifeCountdownStatus {
  ACTIVE
  COMPLETED
}

enum NotificationType {
  COUNTDOWN
  REMINDER
  REVISION_READY
  SECURITY
  SYSTEM
}

enum DiaryEntryStatus {
  DRAFT
  PRESERVED
  ARCHIVED
  DELETED
}

enum DiaryInputMethod {
  TEXT
  VOICE
}

enum Emotion {
  JOY
  SADNESS
  ANGER
  FEAR
  DISGUST
  ANXIETY
}

enum WritingMode {
  VERBATIM
  LIGHT_FIX
  REVIEW
}

enum BeneficiaryStatus {
  INVITED
  REGISTERED
  VERIFIED
  SUSPENDED
  REMOVED
  DECLINED
  REVOKED
}

enum LegacyPolicyStatus {
  DRAFT
  ACTIVE
  PAUSED
  REVOKED
  RELEASED
  EXPIRED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  DISABLED
  FROZEN
  INVALID
}

enum PolicyCompilationStatus {
  NOT_COMPILED
  VALID
  INVALID
}

enum GrantStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum AccessResult {
  ALLOWED
  DENIED
}

enum MediaType {
  PHOTO
  AUDIO
  VIDEO
  MUSIC
  VOICE_MESSAGE
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIChatMode {
  AI_BUDDY
  DIARY_ASSISTANT
}

model User {
  id            String        @id @default(cuid())
  fullName      String        @db.VarChar(100)
  email         String        @unique @db.VarChar(255)
  passwordHash  String        @db.VarChar(255)
  accountStatus AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  owner         Owner?
  sessions      AuthSession[]
  bio           String?       @db.Text
  avatarUrl     String?       @db.VarChar(500)
  timezone      String        @default("UTC") @db.VarChar(100)
  notificationPreferences Json @default("{}")
  notifications Notification[]
  faceEnabled Boolean @default(false)
  faceConsentAt DateTime?
  faceTemplates FaceTemplate[]
  faceChallenges FaceChallenge[]
  faceAuditEvents FaceAuditEvent[]

  @@index([accountStatus])
  @@map("users")
}

model FaceTemplate {
  id              String   @id @default(cuid())
  userId          String
  encryptedVector String   @db.LongText
  keyVersion      Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("face_templates")
}

model FaceChallenge {
  id        String   @id @default(cuid())
  userId    String?
  nonceHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("face_challenges")
}

model FaceAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(40)
  result    String   @db.VarChar(20)
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("face_audit_events")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(500)
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  dedupeKey String?          @unique @db.VarChar(255)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Owner {
  id            String           @id @default(cuid())
  userId        String           @unique
  displayName   String           @db.VarChar(100)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaryEntries  DiaryEntry[]
  beneficiaries Beneficiary[]
  vault         Vault?
  protocols     Protocol[]
  grants        Grant[]
  policies      AccessPolicy[]
  legacyPolicies LegacyPolicy[]
  wishes        LetterOfWishes?
  conversations AIConversation[]
  auditLogs     AccessAuditLog[]
  legacyAuditLogs LegacyAuditLog[]
  lifeCountdowns LifeCountdown[]

  @@map("owners")
}

model LifeCountdown {
  id             String             @id @default(cuid())
  ownerId        String
  durationDays   Int
  startDate      DateTime
  expirationDate DateTime
  status         LifeCountdownStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("life_countdowns")
}

model DiaryEntry {
  id                String            @id @default(cuid())
  ownerId           String
  title             String            @db.VarChar(200)
  category          String            @db.VarChar(80)
  originalContent   String            @db.LongText
  transcript        String?           @db.LongText
  inputMethod       DiaryInputMethod  @default(TEXT)
  normalizedContent String?           @db.LongText
  entryDate         DateTime
  status            DiaryEntryStatus  @default(DRAFT)
  previousHash      String?           @db.VarChar(128)
  contentHash       String            @db.VarChar(128)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  neverShare        Boolean           @default(false)
  emotion           Emotion?
  owner             Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions          EntryVersion[]
  media             MediaAsset[]
  tags              EntryTag[]
  sourceCitations   AIMessageSource[]
  policyLinks       LegacyPolicyEntryLink[]
  photos            EntryPhoto[]

  @@index([ownerId, entryDate])
  @@index([ownerId, status])
  @@map("diary_entries")
}

model EntryPhoto {
  id                  String     @id @default(cuid())
  entryId             String
  ownerId             String
  cloudinaryPublicId  String     @unique @db.VarChar(512)
  width               Int
  height              Int
  bytes               Int
  altText             String?    @db.VarChar(200)
  position            Int        @default(0)
  createdAt           DateTime   @default(now())
  entry               DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, position])
  @@index([ownerId])
  @@map("entry_photos")
}

model EntryVersion {
  id               String      @id @default(cuid())
  diaryEntryId     String
  versionNumber    Int
  writingMode      WritingMode
  sourceContent    String      @db.LongText
  processedContent String?     @db.LongText
  processingNotes  String?     @db.Text
  createdAt        DateTime    @default(now())
  diaryEntry       DiaryEntry  @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@unique([diaryEntryId, versionNumber])
  @@index([diaryEntryId, createdAt])
  @@map("entry_versions")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(50)
  createdAt DateTime   @default(now())
  entries   EntryTag[]

  @@map("tags")
}

model EntryTag {
  diaryEntryId String
  tagId        String
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([diaryEntryId, tagId])
  @@map("entry_tags")
}

model MediaAsset {
  id           String     @id @default(cuid())
  diaryEntryId String
  mediaType    MediaType
  fileName     String     @db.VarChar(255)
  storageKey   String     @unique @db.VarChar(512)
  mimeType     String     @db.VarChar(120)
  byteSize     BigInt
  createdAt    DateTime   @default(now())
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@index([diaryEntryId, mediaType])
  @@map("media_assets")
}

model Beneficiary {
  id            String            @id @default(cuid())
  ownerId       String
  fullName      String            @db.VarChar(100)
  email         String            @db.VarChar(255)
  relationship  String?           @db.VarChar(80)
  status        BeneficiaryStatus @default(INVITED)
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  owner         Owner             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  policies      AccessPolicy[]
  legacyPolicies LegacyPolicy[]
  grants        Grant[]
  conversations AIConversation[]
  auditLogs     AccessAuditLog[]

  @@unique([ownerId, email])
  @@index([ownerId, status])
  @@map("beneficiaries")
}

model LegacyPolicy {
  id                    String             @id @default(cuid())
  ownerId               String
  beneficiaryId         String
  name                  String             @db.VarChar(150)
  description           String?            @db.Text
  status                LegacyPolicyStatus @default(DRAFT)
  accessLevel           String             @default("read_only") @db.VarChar(30)
  scopeType             String             @db.VarChar(30)
  scopeCategories       Json?
  scopeDateFrom         DateTime?
  scopeDateTo           DateTime?
  excludedEntryIds      Json
  releaseMethod         String             @db.VarChar(30)
  releaseAt             DateTime?
  verifierBeneficiaryId String?
  coolingOffDays        Int                @default(7)
  expiresAt             DateTime?
  releasedAt            DateTime?
  releaseRequestedAt    DateTime?
  releaseReadyAt        DateTime?
  activeScopeKey        String?            @db.VarChar(64)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  owner                 Owner              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  beneficiary           Beneficiary        @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  entryLinks            LegacyPolicyEntryLink[]
  auditLogs             LegacyAuditLog[]
  releaseTokens         LegacyReleaseToken[]

  @@index([ownerId, status])
  @@index([beneficiaryId])
  @@unique([ownerId, beneficiaryId, activeScopeKey])
  @@map("legacy_policies")
}

model LegacyPolicyEntryLink {
  policyId String
  entryId  String
  policy   LegacyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  entry    DiaryEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([policyId, entryId])
  @@index([policyId])
  @@map("policy_entry_links")
}

model LegacyAuditLog {
  id        String        @id @default(cuid())
  ownerId   String
  policyId  String?
  actorType String        @db.VarChar(20)
  actorId   String?
  action    String        @db.VarChar(100)
  metadata  Json?
  ipHash    String?       @db.VarChar(64)
  createdAt DateTime      @default(now())
  owner     Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  policy    LegacyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([policyId])
  @@map("legacy_audit_log")
}

model LegacyReleaseToken {
  id        String   @id @default(cuid())
  policyId  String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  policy    LegacyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([expiresAt])
  @@map("legacy_release_tokens")
}

model Vault {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("vaults")
}

model Protocol {
  id          String   @id @default(cuid())
  ownerId     String
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("protocols")
}

model AccessPolicy {
  id                String                  @id @default(cuid())
  ownerId           String
  beneficiaryId     String
  name              String                  @db.VarChar(150)
  description       String?                 @db.Text
  sourceCode        String                  @db.LongText
  compiledFacts     String?                 @db.LongText
  compilationStatus PolicyCompilationStatus @default(NOT_COMPILED)
  validationErrors  Json?
  status            PolicyStatus            @default(DRAFT)
  currentVersion    Int                     @default(1)
  releaseAt         DateTime?
  frozenAt          DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  owner             Owner                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  beneficiary       Beneficiary             @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  versions          PolicyVersion[]
  rules             PolicyRule[]
  grants            Grant[]

  @@index([ownerId, status])
  @@index([beneficiaryId, status])
  @@map("access_policies")
}

model PolicyVersion {
  id                String                  @id @default(cuid())
  policyId          String
  versionNumber     Int
  sourceCode        String                  @db.LongText
  compiledFacts     String?                 @db.LongText
  compilationStatus PolicyCompilationStatus @default(NOT_COMPILED)
  validationErrors  Json?
  frozenAt          DateTime?
  createdAt         DateTime                @default(now())
  policy            AccessPolicy            @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

model PolicyRule {
  id             String       @id @default(cuid())
  policyId       String
  resourceType   String       @db.VarChar(80)
  resourceId     String?      @db.VarChar(100)
  allowedActions Json
  conditions     Json?
  createdAt      DateTime     @default(now())
  policy         AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, resourceType])
  @@map("policy_rules")
}

model Grant {
  id             String        @id @default(cuid())
  ownerId        String
  beneficiaryId  String
  policyId       String?
  status         GrantStatus   @default(ACTIVE)
  allowedActions Json
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  owner          Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  beneficiary    Beneficiary   @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  policy         AccessPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([beneficiaryId, status])
  @@map("grants")
}

model LetterOfWishes {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  title     String   @db.VarChar(200)
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("letters_of_wishes")
}

model AIConversation {
  id            String       @id @default(cuid())
  ownerId       String
  beneficiaryId String?
  mode          AIChatMode   @default(AI_BUDDY)
  title         String?      @db.VarChar(200)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  owner         Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  messages      AIMessage[]

  @@index([ownerId, updatedAt])
  @@index([beneficiaryId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String            @db.LongText
  createdAt      DateTime          @default(now())
  conversation   AIConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources        AIMessageSource[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIMessageSource {
  id           String     @id @default(cuid())
  messageId    String
  diaryEntryId String
  citationText String?    @db.Text
  createdAt    DateTime   @default(now())
  message      AIMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  diaryEntry   DiaryEntry @relation(fields: [diaryEntryId], references: [id], onDelete: Cascade)

  @@unique([messageId, diaryEntryId])
  @@map("ai_message_sources")
}

model AccessAuditLog {
  id            String       @id @default(cuid())
  ownerId       String
  actorUserId   String?
  beneficiaryId String?
  action        String       @db.VarChar(100)
  resourceType  String       @db.VarChar(80)
  resourceId    String?      @db.VarChar(100)
  result        AccessResult
  metadata      Json?
  createdAt     DateTime     @default(now())
  owner         Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([beneficiaryId, createdAt])
  @@index([action, result])
  @@map("access_audit_logs")
}
